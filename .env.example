# ORBIT yapılandırması — bu dosyayı .env olarak kopyalayın.
# Tüm değişkenler isteğe bağlıdır; uygulama varsayılanlarla çalışır.

# Sunucu portu (Replit/AppJet otomatik atar)
PORT=3000

# Veritabanı ve yüklenen dosyaların dizini
DATA_DIR=./data
# Alternatif veritabanı yolu
# DATABASE_PATH=./data/orbit.db

# Oturum çerezi güvenliği (https arkasında true yapın)
COOKIE_SECURE=false
# Çerez imzalama anahtarı (boşsa rastgele üretilir)
# SESSION_SECRET=

# WebRTC için TURN sunucusu (NAT arkasındaki kullanıcılar için önerilir)
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Alternatif STUN listesi (virgülle ayrılmış)
# STUN_URLS=stun:stun.l.google.com:19302

# Şifre sıfırlama e-postası (yoksa bağlantı arayüzde gösterilir)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="ORBIT <no-reply@example.com>"
# APP_URL=https://orbit.example.com
